{
  "entities": {
    "products": {
      "title": "products",
      "description": "Store affiliate products",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "imageUrl": { "type": "string" },
        "affiliateUrl": { "type": "string" },
        "category": { "type": "string" },
        "platform": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "clicksCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "affiliateUrl"]
    },
    "highlights": {
      "title": "highlights",
      "description": "Promotional highlights",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "badge": { "type": "string" },
        "bannerUrl": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["title"]
    },
    "categories": {
      "title": "categories",
      "description": "Product categories",
      "properties": {
        "name": { "type": "string" },
        "icon": { "type": "string" }
      },
      "required": ["name"]
    },
    "clickLogs": {
      "title": "clickLogs",
      "description": "Affiliate click tracking logs",
      "properties": {
        "productId": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["productId"]
    },
    "settings": {
      "title": "settings",
      "description": "Configurações da loja e eventos",
      "properties": {
        "storeName": { "type": "string" },
        "storeSlogan": { "type": "string" },
        "logoUrl": { "type": "string" },
        "bannerHeadline": { "type": "string" },
        "bannerHeadlineGradient": { "type": "string" },
        "badgeTag1": { "type": "string" },
        "badgeTag2": { "type": "string" },
        "promoPillText": { "type": "string" },
        "topNoticeText": { "type": "string" }
      }
    },
    "subscribers": {
      "title": "subscribers",
      "description": "Newsletter subscribers",
      "properties": {
        "email": { "type": "string" },
        "subscribedAt": { "type": "string" }
      }
    }
  }
}
